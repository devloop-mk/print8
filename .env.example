# Copy to .env.local and fill in from Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SITE_URL=https://print8.mk
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_STORAGE_BUCKET=uploads

# Direct Postgres connection (for one-time migrations only)
# Dashboard → Project Settings → Database → Connection string → URI (pooler, port 5432)
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# Or set only the database password (script builds the URL from NEXT_PUBLIC_SUPABASE_URL):
# SUPABASE_DB_PASSWORD=your_database_password

# Cloudflare R2 (S3-compatible object storage)
# Create bucket + API token in Cloudflare Dashboard → R2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=print8

# Public CDN URL for catalog assets (R2 public bucket URL or custom domain)
# Example: https://assets.print8.mk or https://pub-xxxx.r2.dev
NEXT_PUBLIC_ASSETS_CDN_URL=

# Email (Resend — https://resend.com)
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=Print 8 <orders@print8.mk>
ORDER_NOTIFICATION_EMAIL=info@print8.mk

# Admin dashboard (set strong values in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
ADMIN_SESSION_SECRET=generate_a_long_random_secret_at_least_32_chars
