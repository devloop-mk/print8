# Supabase Auth: enable Email provider in Dashboard → Authentication → Providers
# Google sign-in: see supabase/email-templates/README.md (Google section)
# Set Site URL to your domain (and http://localhost:3000 for local dev).
#
# Verification / password-reset emails are sent by Supabase Auth by default.
# To send them from your domain (e.g. orders@print8.mk via Brevo):
#   Dashboard → Authentication → SMTP Settings → Enable custom SMTP
#   Host: smtp-relay.brevo.com | Port: 587 (TLS)
#   Username: your Brevo account email (SMTP & API → SMTP)
#   Password: your Brevo SMTP key (xsmtpsib-…, not the API key)
#   Sender email: must match a verified sender in Brevo (see EMAIL_FROM)
# Then customize templates under Authentication → Email Templates.
# Branded HTML for confirm-signup: supabase/email-templates/confirm-signup.html
#
# Local dev shortcut: Authentication → Providers → Email → disable "Confirm email"
# so signup logs you in immediately without waiting for mail.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SITE_URL=https://print8.mk
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_STORAGE_BUCKET=uploads

# Direct Postgres connection (for one-time migrations only)
# Dashboard → Project Settings → Database → Connection string → URI (pooler, port 5432)
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# Or set only the database password (script builds the URL from NEXT_PUBLIC_SUPABASE_URL):
# SUPABASE_DB_PASSWORD=your_database_password

# Cloudflare R2 (S3-compatible object storage)
# Create bucket + API token in Cloudflare Dashboard → R2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=print8

# Public CDN URL for catalog assets (R2 public bucket URL or custom domain)
# Example: https://assets.print8.mk or https://pub-xxxx.r2.dev
# In production, /NEW_DESIGNS/** resolves here (catalog/… on R2) — not Next public/.
NEXT_PUBLIC_ASSETS_CDN_URL=

# Merch design catalog source: database | merge | static
# Default when unset: database if VERCEL_ENV=production or NEXT_PUBLIC_ASSETS_CDN_URL is set; else merge.
# Seed first: npm run seed:managed-product-designs
# CATALOG_SOURCE=database

# Force CDN URLs even in local development (optional)
# ASSETS_FORCE_CDN=1

# Email (Brevo — https://www.brevo.com)
# API key: SMTP & API → API keys (xkeysib-…)
BREVO_API_KEY=xkeysib-your_api_key
EMAIL_FROM=Print 8 <orders@print8.mk>
# Where Brevo sends admin copies (new orders + contact form). Use any inbox you read —
# your personal Gmail is fine. You do NOT need a mailbox on print8.mk unless you want one.
# Optional: Cloudflare Email Routing forwards info@print8.mk → your personal email (free).
ORDER_NOTIFICATION_EMAIL=your-personal@gmail.com

# Admin dashboard (set strong values in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
ADMIN_SESSION_SECRET=generate_a_long_random_secret_at_least_32_chars
